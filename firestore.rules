rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      let adminEmails = ["juanomonzon@gmail.com", "charlymonzon.1986@gmail.com", "socia@example.com", "ruth1094@gmail.com"];
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email.lower() in adminEmails && request.auth.token.email_verified == true));
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'plan']) &&
             data.uid == userId &&
             data.email is string &&
             data.role in ['admin', 'user'] &&
             data.plan in ['free', 'pro', 'studio'] &&
             data.email.size() < 255;
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['userId', 'url', 'settings']) &&
             data.userId == request.auth.uid &&
             data.url is string &&
             data.url.size() < 2000000 && // Limit for data URLs or long links
             data.settings is map &&
             (!('title' in data) || (data.title is string && data.title.size() < 200)) &&
             (!('size' in data) || (data.size is number && data.size >= 0));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data, userId) && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data, userId) && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
    }

    match /photos/{photoId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      allow create: if isAuthenticated() && isValidPhoto(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidPhoto(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /presets/{presetId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.isSystem == true || isAdmin());
      allow create: if isAuthenticated() && (
        (request.resource.data.isSystem == false && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.isSystem == true && isAdmin())
      );
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
